[Unit]
Description=opersona engine (Claude Agent SDK)
After=network.target postgresql.service
[Service]
User=bee
WorkingDirectory=/home/bee/opersona/apps/engine
EnvironmentFile=/home/bee/opersona/.env
Environment=NODE_ENV=production ENGINE_DATA_DIR=/home/bee/opersona/data PATH=/home/bee/.local/share/fnm/node-versions/v22.23.2/installation/bin:/usr/local/bin:/usr/bin:/bin HOME=/home/bee
ExecStart=/home/bee/.local/share/fnm/node-versions/v22.23.2/installation/bin/pnpm -s start
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
