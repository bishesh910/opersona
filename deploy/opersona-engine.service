# Template: adjust User, paths, and the node/pnpm PATH for your install.
[Unit]
Description=opersona engine (Claude Agent SDK)
After=network.target postgresql.service
[Service]
User=opersona
WorkingDirectory=/opt/opersona/apps/engine
EnvironmentFile=/opt/opersona/.env
Environment=NODE_ENV=production ENGINE_DATA_DIR=/opt/opersona/data PATH=/usr/local/bin:/usr/bin:/bin HOME=/home/opersona
ExecStart=/usr/local/bin/pnpm -s start
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
