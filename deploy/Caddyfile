# opersona — TLS terminator + reverse proxy (template: replace the domain).
# The domain block gets a real Let's Encrypt certificate automatically once
# your domain resolves to this box and ports 80/443 are forwarded.
opersona.example.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	request_body {
		max_size 100MB
	}
	reverse_proxy 127.0.0.1:3000 {
		# SSE must not be buffered
		flush_interval -1
	}
	log
}

# Optional LAN fallback (self-signed cert): use your box's LAN IP with `tls internal`.
# 192.0.2.10 {
# 	tls internal
# 	encode zstd gzip
# 	reverse_proxy 127.0.0.1:3000 {
# 		flush_interval -1
# 	}
# }
