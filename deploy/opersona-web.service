# Template: adjust User, paths, and the node/pnpm PATH for your install.
[Unit]
Description=opersona web (Next.js)
After=network.target
[Service]
User=opersona
WorkingDirectory=/opt/opersona/apps/web
EnvironmentFile=/opt/opersona/.env
Environment=NODE_ENV=production PATH=/usr/local/bin:/usr/bin:/bin HOME=/home/opersona
ExecStart=/usr/local/bin/pnpm -s start
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
