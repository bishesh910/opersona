{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "opersona",
  "version": "0.2.1",
  "identifier": "me.opersona.tray",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pair",
        "title": "Pair opersona",
        "url": "index.html",
        "width": 460,
        "height": 320,
        "visible": false,
        "resizable": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/128x128.png",
      "icons/32x32.png"
    ],
    "category": "Productivity",
    "shortDescription": "Your persona, powered by your own Claude."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "opersona"
        ]
      }
    }
  }
}