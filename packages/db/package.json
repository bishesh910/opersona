    "push": "drizzle-kit push",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@opersona/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.10"
  },
  "license": "AGPL-3.0-or-later"
}
