# Postgres (pilot: local instance created on this box)
DATABASE_URL=postgres://clone:CHANGE_ME@localhost:5432/opersona

# Engine (Hono + Claude Agent SDK)
ENGINE_PORT=4000
ENGINE_DATA_DIR=./data            # per-clone workspaces live here (disposable)
ENGINE_INTERNAL_TOKEN=change-me   # shared secret between web and engine

# Platform-level key used ONLY when an org has not set its own (BYO key is the default model)
ANTHROPIC_API_KEY=

# Column-encryption key for org secrets (32 bytes, base64). Generate: openssl rand -base64 32
SECRETS_KEK=

# Web (Next.js)
NEXT_PUBLIC_ENGINE_URL=http://localhost:4000
BETTER_AUTH_SECRET=change-me-too
BETTER_AUTH_URL=http://localhost:3000

# Open sign-up (opersona.me runs true). false = invite-only, the safe self-host default.
ALLOW_SIGNUP=false
# Make two-factor mandatory for every account (default: optional, nudged in Settings)
REQUIRE_2FA=false

# Outbound email (Resend). Unset = no verification emails / password resets (app stays fully usable).
RESEND_API_KEY=
EMAIL_FROM=

# Monthly USD cap for workspaces running on the platform ANTHROPIC_API_KEY fallback (BYO-key workspaces set their own in Settings)
ENGINE_DEFAULT_MONTHLY_BUDGET_USD=20

# Cloudflare Turnstile bot wall for sign-up (dark until both are set)
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# List every origin the app is served from
TRUSTED_ORIGINS=http://localhost:3000

# Social sign-in (buttons appear automatically when set; requires a real domain — see deploy/README.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
# Only these accounts can create organizations (comma-separated)
PLATFORM_ADMIN_EMAILS=
